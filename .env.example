# Progresso — environment configuration (host-agnostic, epic Q5).
# Copy to .env for local use; never commit real secrets (.env is gitignored).

# Which settings module to load. Dev is the default in manage.py/wsgi/asgi.
#   progresso.settings.dev  | progresso.settings.prod
DJANGO_SETTINGS_MODULE=progresso.settings.dev

# Django secret key. dev.py supplies an insecure default; REQUIRED in prod.
SECRET_KEY=change-me

# Database. Unset -> SQLite (dev). In prod set a Postgres URL, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Prod only: comma-separated allowed hostnames.
# ALLOWED_HOSTS=app.example.com,www.example.com

# Vercel Blob read-write token for progress-photo storage (P3).
# Unset -> local filesystem fallback under MEDIA_ROOT (dev only). REQUIRED in
# prod: the serverless FS is ephemeral, so photos must go to Blob.
# BLOB_READ_WRITE_TOKEN=
